  "decision": {
    "outcome": "external_only",
    "dedicated_provider": false,
    "packaged_runtime_or_models": false,
    "boundary": "TranscribeIt supports a user-managed llama-server through the generic OpenAI-compatible provider. It does not discover, download, verify, launch, monitor, update, stop, or clean llama.cpp or Qwen GGUF artifacts.",
    "reasons": [
      "The 0.6B and 1.7B Q8 paths expose only one untimed, non-diarized text segment through the compatible endpoint.",
      "The 40-minute fixture requires a 65536-token context and materially higher memory than the short-audio configuration.",
      "Packaging would add a llama.cpp runtime plus separate model and multimodal-projector artifacts without improving TranscribeIt's timestamp, speaker, or metadata contract.",
      "The existing generic base-URL path preserves an opt-in compatibility route without compromising the standalone binary's managed-artifact boundary."
    ]
  },
